# Reprieve - Hackathon Environment Configuration

# Database (FalkorDB)
FALKORDB_URL=redis://localhost:6379
FALKORDB_TLS=false
GRAPH_PREFIX=dev_

# API Configuration
PORT=8000
ENV_NAME=local
WEB_ORIGIN=http://localhost:3000

# Authentication (Clerk)
CLERK_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder

# LLM Provider - Nebius Token Factory (Nebius x NVIDIA Global AI Hackathon)
LLM_PRIMARY=compat
COMPAT_BASE_URL=https://api.tokenfactory.nebius.ai/v1
COMPAT_API_KEY=your_nebius_token_factory_key_here
COMPAT_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional fallback or alternative local LLM
LLM_FALLBACK=none
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen3:8b

# External Search & Threat Intelligence (Tavily $3,000 Prize Bounty)
TAVILY_API_KEY=your_tavily_api_key_here

# Internal Scheduler Secret
INTERNAL_TICK_SECRET=dev_tick_secret_placeholder
