# FastAPI base URL (no trailing slash). The client calls ${NEXT_PUBLIC_API_URL}/api/v1/...
NEXT_PUBLIC_API_URL=http://localhost:8000
# Clerk. Leave empty in local dev to run in Clerk keyless mode (temporary dev keys).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Absolute URL of this app (metadata, OG image)
NEXT_PUBLIC_APP_URL=http://localhost:3000
